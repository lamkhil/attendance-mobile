{
    "hosting": {
        "public": "build/web",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ],
        "headers": [
            {
                "source": "/index.html",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/flutter_bootstrap.js",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/main.dart.js",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            }
        ]
    },
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "projectId": "attendance-dpmptsp",
                    "appId": "1:746800149870:android:7035e2db35d559ef3afd7f",
                    "fileOutput": "android/app/google-services.json"
                }
            },
            "dart": {
                "lib/firebase_options.dart": {
                    "projectId": "attendance-dpmptsp",
                    "configurations": {
                        "android": "1:746800149870:android:7035e2db35d559ef3afd7f",
                        "ios": "1:746800149870:ios:ac7fc8e328e68bac3afd7f",
                        "macos": "1:746800149870:ios:ac7fc8e328e68bac3afd7f",
                        "web": "1:746800149870:web:4886cca4c84ca97b3afd7f",
                        "windows": "1:746800149870:web:b619fd6604a2ef783afd7f"
                    }
                }
            }
        }
    }
}